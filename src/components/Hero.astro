---
// Cabecera de página: foto a todo lo ancho con velo negro al 45 %, título y texto centrados.
import Img from './Img.astro';

interface Props {
  image: string;
  title: string;
  minHeight?: number;
  position?: string;
}
const { image, title, minHeight = 521, position = 'center' } = Astro.props;
---

<section class="hero" style={`--min-h:${minHeight}px`}>
  <Img name={image} class="hero-img" widths={[800, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${position}`} />
  <div class="hero-velo" aria-hidden="true"></div>
  <div class="container hero-inner">
    <h1>{title}</h1>
    {Astro.slots.has('default') && <div class="hero-text"><slot /></div>}
    {Astro.slots.has('actions') && <div class="hero-actions"><slot name="actions" /></div>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: var(--min-h);
    padding: 96px 0;
    color: var(--cream);
    text-align: center;
    overflow: hidden;
    background: var(--olive);
  }
  .hero :global(.hero-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-velo { position: absolute; inset: 0; background: rgba(0, 0, 0, .45); }
  .hero-inner { position: relative; display: flex; flex-direction: column; align-items: center; }
  h1 { max-width: 760px; }
  .hero-text { max-width: 503px; margin-top: 16px; }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 48px; }
  @media (max-width: 640px) {
    .hero { min-height: 350px; padding: 72px 0; }
    .hero-actions { flex-direction: column; align-items: stretch; width: 100%; max-width: 320px; margin-top: 32px; }
  }
</style>
