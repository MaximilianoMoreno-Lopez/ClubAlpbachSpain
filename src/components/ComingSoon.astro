---
// Bloque "Coming soon!" que muestran Partners y Community en la web original.
import Img from './Img.astro';
---

<section class="soon">
  <Img name="hero-soon" class="soon-img" widths={[800, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="soon-velo" aria-hidden="true"></div>
  <div class="container soon-inner">
    <h1>Coming soon!</h1>
    <p>This page is still being built. Come back later!</p>
  </div>
</section>

<style>
  .soon { position: relative; display: grid; align-items: center; min-height: 296px; padding: 64px 0; color: #fff; text-align: center; overflow: hidden; background: var(--olive); }
  .soon :global(.soon-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .soon-velo { position: absolute; inset: 0; background: rgba(0, 0, 0, .45); }
  .soon-inner { position: relative; }
  .soon p { margin-top: 16px; }
  @media (max-width: 640px) { .soon { min-height: 350px; } }
</style>
