---
// Imagen optimizada por nombre de archivo (src/assets/img/<name>.jpg|png).
// Astro genera WebP en varios tamaños; aquí solo se pasa el nombre corto.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  style?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/img/*.{jpg,png}', { eager: true });
const {
  name,
  alt = '',
  widths = [480, 800, 1200],
  sizes = '(min-width: 1256px) 600px, 100vw',
  class: cls,
  style,
  loading = 'lazy',
  fetchpriority,
} = Astro.props;
const entry = Object.entries(images).find(([p]) => p.split('/').pop()!.replace(/\.(jpg|png)$/, '') === name);
if (!entry) throw new Error(`Imagen no encontrada: ${name}`);
const src = entry[1].default;
const ws = widths.filter((w) => w <= src.width);
---

<Image
  src={src}
  alt={alt}
  widths={ws.length ? ws : [src.width]}
  sizes={sizes}
  class={cls}
  style={style}
  loading={loading}
  fetchpriority={fetchpriority}
  format="webp"
  quality={78}
/>
