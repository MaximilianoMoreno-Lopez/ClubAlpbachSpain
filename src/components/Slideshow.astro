---
// Carrusel a todo lo ancho (635 px) con flechas y puntos crema, sin autoplay ni bucle, como la original.
import Img from './Img.astro';

interface Props { images: string[]; label?: string; }
const { images, label = 'Photos from the European Forum Alpbach' } = Astro.props;
---

<section class="slides" aria-roledescription="carousel" aria-label={label}>
  <div class="slides-track">
    {images.map((name, i) => (
      <div class="slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${images.length}`} aria-hidden={i === 0 ? undefined : 'true'}>
        <Img name={name} class="cover" widths={[800, 1280, 1920]} sizes="100vw" />
      </div>
    ))}
  </div>
  <button class="slides-arrow prev" type="button" aria-label="Previous slide" disabled>
    <svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button class="slides-arrow next" type="button" aria-label="Next slide">
    <svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="slides-dots">
    {images.map((_, i) => (
      <button type="button" aria-label={`Go to slide ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}></button>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.slides').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const track = root.querySelector<HTMLElement>('.slides-track')!;
    const prev = root.querySelector<HTMLButtonElement>('.prev')!;
    const next = root.querySelector<HTMLButtonElement>('.next')!;
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.slides-dots button')];
    let i = 0;
    const go = (n: number) => {
      i = Math.max(0, Math.min(slides.length - 1, n));
      track.style.transform = `translateX(${-100 * i}%)`;
      slides.forEach((s, k) => (k === i ? s.removeAttribute('aria-hidden') : s.setAttribute('aria-hidden', 'true')));
      dots.forEach((d, k) => (k === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      prev.disabled = i === 0;
      next.disabled = i === slides.length - 1;
    };
    prev.addEventListener('click', () => go(i - 1));
    next.addEventListener('click', () => go(i + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
    // Deslizar con el dedo en móvil
    let x0: number | null = null;
    root.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    root.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) go(i + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  });
</script>

<style>
  .slides { position: relative; height: 635px; overflow: hidden; background: var(--olive); }
  .slides-track { display: flex; height: 100%; transition: transform .6s var(--ease); }
  .slide { flex: 0 0 100%; height: 100%; }
  .slides-arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    display: grid; place-items: center;
    width: 56px; height: 56px;
    background: none; border: 0; color: var(--cream); cursor: pointer;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, .5));
    transition: opacity .2s;
  }
  .slides-arrow:disabled { opacity: 0; pointer-events: none; }
  .prev { left: 16px; }
  .next { right: 16px; }
  .slides-dots { position: absolute; left: 0; right: 0; bottom: 24px; display: flex; justify-content: center; gap: 6px; }
  .slides-dots button {
    width: 24px; height: 24px; padding: 0;
    background: none; border: 0; cursor: pointer;
    display: grid; place-items: center;
  }
  .slides-dots button::before {
    content: ''; width: 10px; height: 10px; border-radius: 50%;
    border: 1px solid var(--cream); background: transparent;
    box-shadow: 0 0 3px rgba(0, 0, 0, .4);
  }
  .slides-dots button[aria-current='true']::before { background: var(--cream); }
  @media (max-width: 640px) { .slides { height: 300px; } }
  @media (prefers-reduced-motion: reduce) { .slides-track { transition: none; } }
</style>
